---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const ready = Boolean(site.giscus.repoId && site.giscus.categoryId);
---

<Base title="留言">
  <section class="gb">
    <div class="wrap narrow">
      <h1 class="display headline">留言</h1>
      <p class="intro">想说什么都行。写下只需要三步。</p>

      <ol class="steps">
        <li><span class="n">01</span><p>点下面评论框右下角的「使用 GitHub 登录」，用 GitHub 账号授权一次。</p></li>
        <li><span class="n">02</span><p>在输入框里写内容，支持 Markdown，可以先点「预览」看效果。</p></li>
        <li><span class="n">03</span><p>点「发表评论」，页面刷新后就能看到。</p></li>
      </ol>

      <p class="alt">
        没有 GitHub 账号，也可以直接写信给我：<a class="link" href={`mailto:${site.email}`}>{site.email}</a>，我读后会贴到评论区。
      </p>

      {ready ? (
        <div
          class="giscus-wrap"
          data-repo={site.giscus.repo}
          data-repo-id={site.giscus.repoId}
          data-category={site.giscus.category}
          data-category-id={site.giscus.categoryId}
          data-mapping={site.giscus.mapping}
        ></div>
      ) : (
        <p class="pending">
          留言板尚未接好。可以直接写信：<a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      )}
    </div>
  </section>
</Base>

<style>
  .gb { padding: clamp(7rem, 15vh, 10rem) 0 clamp(4rem, 10vh, 7rem); }
  .narrow { max-width: 46rem; }
  .headline {
    margin: 1rem 0 0;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
  }
  .intro {
    margin: 1.4rem 0 1.6rem;
    color: var(--muted);
    font-size: 1.02rem;
  }
  .steps {
    margin: 0 0 clamp(1.8rem, 4vw, 2.4rem);
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.6rem;
    align-items: baseline;
  }
  .steps .n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--orange);
  }
  .steps p { margin: 0; font-size: 0.98rem; line-height: 1.85; color: var(--ink); }
  .alt {
    margin: 0 0 clamp(2.2rem, 5vw, 3rem);
    font-size: 0.92rem;
    line-height: 1.85;
    color: var(--muted);
  }
  .giscus-wrap { min-height: 12rem; }
  .pending {
    padding: 1.4rem 1.5rem;
    background: var(--sea-wash);
    font-size: 0.98rem;
    line-height: 1.9;
    color: var(--muted);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--ink);
  }
</style>

<script>
  const theme = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  // 静态 <script> 在 View Transitions 里只会执行一次，第二次进留言页 iframe 是空的。
  // 改成每次 page-load 自己注入，节点随页面一起销毁，不存在残留。
  function mount() {
    const wrap = document.querySelector<HTMLElement>('.giscus-wrap');
    if (!wrap || wrap.querySelector('iframe') || wrap.dataset.mounted === '1') return;
    const repo = wrap.dataset.repo;
    const repoId = wrap.dataset.repoId;
    const categoryId = wrap.dataset.categoryId;
    if (!repo || !repoId || !categoryId) return;
    wrap.dataset.mounted = '1';

    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    const attrs: Record<string, string> = {
      'data-repo': repo,
      'data-repo-id': repoId,
      'data-category': wrap.dataset.category || '',
      'data-category-id': categoryId,
      'data-mapping': wrap.dataset.mapping || 'pathname',
      'data-strict': '0',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'top',
      'data-theme': theme(),
      'data-lang': 'zh-CN',
      'data-loading': 'lazy',
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    wrap.appendChild(s);
  }

  function sync() {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
  }

  if (!(window as any).__giscusWired) {
    (window as any).__giscusWired = true;
    // documentElement 只换主题属性，不随导航替换，观察器注册一次即可
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://giscus.app') return;
      sync();
    });
  }

  document.addEventListener('astro:page-load', mount);
  mount();
</script>
