---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="后台" bare>
  <section class="admin">
    <div class="wrap narrow">
      <header class="head">
        <p class="eyebrow">ADMIN</p>
        <h1 class="display headline">写文章</h1>
        <p class="hint">
          提交即一次 commit，GitHub Actions 会在 1–2 分钟内重建站点。
          凭证只存在本机浏览器。
        </p>
      </header>

      <div id="auth" class="panel">
        <label class="field">
          <span class="label">GitHub Token（fine-grained，只勾选本仓库 Contents 读写）</span>
          <input id="token" type="password" autocomplete="off" placeholder="github_pat_..." />
        </label>
        <div class="row">
          <button id="auth-btn" class="btn primary">连接</button>
          <button id="forget-btn" class="btn">清除</button>
          <span id="auth-state" class="state"></span>
        </div>
      </div>

      <div id="editor" class="panel hidden">
        <div class="row between">
          <span id="file-state" class="state">草稿</span>
          <div class="row">
            <button id="new-btn" class="btn">新建</button>
            <button id="save-btn" class="btn primary">提交</button>
            <button id="del-btn" class="btn danger">删除</button>
          </div>
        </div>

        <div class="grid">
          <label class="field">
            <span class="label">标题</span>
            <input id="f-title" type="text" placeholder="xv6 实验-COW" />
          </label>
          <label class="field">
            <span class="label">文件名（slug）</span>
            <input id="f-slug" type="text" placeholder="xv6cow" />
          </label>
          <label class="field">
            <span class="label">日期</span>
            <input id="f-date" type="date" />
          </label>
          <label class="field">
            <span class="label">分类</span>
            <input id="f-category" type="text" placeholder="技术" />
          </label>
          <label class="field">
            <span class="label">标签（逗号分隔）</span>
            <input id="f-tags" type="text" placeholder="xv6, os" />
          </label>
          <label class="field">
            <span class="label">阅读时长（分钟）</span>
            <input id="f-read" type="number" min="1" value="5" />
          </label>
        </div>

        <label class="field">
          <span class="label">摘要</span>
          <input id="f-excerpt" type="text" placeholder="一句话说清这篇写了什么" />
        </label>

        <label class="field">
          <span class="label">正文（Markdown）</span>
          <textarea id="f-body" rows="22" spellcheck="false"></textarea>
        </label>

        <div class="row">
          <input id="upload" type="file" accept="image/*" hidden />
          <button id="upload-btn" class="btn">插入图片</button>
          <span id="status" class="state"></span>
        </div>
      </div>

      <div class="panel">
        <div class="row between">
          <span class="label">已有文件</span>
          <button id="refresh-btn" class="btn">刷新</button>
        </div>
        <ul id="files" class="files"></ul>
      </div>
    </div>
  </section>
</Base>

<script>
  import { site } from '../site.config';

  const API = 'https://api.github.com';
  const { owner, repo, branch, postsDir, imagesDir } = site.admin;
  const tokenKey = 'gh_pat_snow_blog';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const enc = new TextEncoder();
  const dec = new TextDecoder();

  let token = localStorage.getItem(tokenKey) || '';
  let currentSha: string | null = null;
  let currentSlug = '';

  const b64encode = (text: string) => {
    const bytes = enc.encode(text);
    let bin = '';
    bytes.forEach((b) => (bin += String.fromCharCode(b)));
    return btoa(bin);
  };
  const b64decode = (data: string) => {
    const bin = atob(data.replace(/\n/g, ''));
    const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0));
    return dec.decode(bytes);
  };

  async function gh(path: string, init: RequestInit = {}) {
    const res = await fetch(`${API}${path}`, {
      ...init,
      headers: {
        Accept: 'application/vnd.github+json',
        Authorization: `Bearer ${token}`,
        'X-GitHub-Api-Version': '2022-11-28',
        ...(init.headers || {}),
      },
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(`${res.status} ${err.message || res.statusText}`);
    }
    return res.status === 204 ? null : res.json();
  }

  const say = (msg: string, tone: 'ok' | 'err' | '' = '') => {
    const el = $('status');
    el.textContent = msg;
    el.dataset.tone = tone;
  };

  async function verify() {
    if (!token) return;
    try {
      const me = await gh('/user');
      $('auth-state').textContent = `已连接 ${me.login}`;
      $('auth-state').dataset.tone = 'ok';
      $('editor').classList.remove('hidden');
      loadFiles();
    } catch (e) {
      $('auth-state').textContent = `连接失败：${(e as Error).message}`;
      $('auth-state').dataset.tone = 'err';
      $('editor').classList.add('hidden');
    }
  }

  async function loadFiles() {
    const list = $('files');
    list.innerHTML = '';
    try {
      const items = await gh(`/repos/${owner}/${repo}/contents/${postsDir}?ref=${branch}`);
      (items as any[])
        .filter((i) => i.name.endsWith('.md'))
        .forEach((item) => {
          const li = document.createElement('li');
          const a = document.createElement('button');
          a.className = 'file';
          a.textContent = item.name;
          a.onclick = () => openFile(item.name);
          li.appendChild(a);
          list.appendChild(li);
        });
    } catch (e) {
      list.innerHTML = `<li class="state err">${(e as Error).message}</li>`;
    }
  }

  async function openFile(name: string) {
    try {
      const res = await gh(`/repos/${owner}/${repo}/contents/${postsDir}/${name}?ref=${branch}`);
      const raw = b64decode(res.content);
      currentSha = res.sha;
      currentSlug = name.replace(/\.md$/, '');
      const m = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      const fm = m ? m[1] : '';
      const body = m ? m[2] : raw;
      $('f-title').value = pick(fm, 'title');
      $('f-slug').value = currentSlug;
      $('f-date').value = (pick(fm, 'date') || '').slice(0, 10);
      $('f-category').value = pick(fm, 'category') || '随笔';
      $('f-tags').value = (pick(fm, 'tags') || '')
        .replace(/^\[|\]$/g, '')
        .split(',')
        .map((s: string) => s.trim().replace(/^["']|["']$/g, ''))
        .filter(Boolean)
        .join(', ');
      $('f-excerpt').value = pick(fm, 'excerpt');
      $('f-read').value = pick(fm, 'readTime') || '5';
      $('f-body').value = body.trim();
      $('file-state').textContent = `编辑 ${name}`;
      say('');
    } catch (e) {
      say(`读取失败：${(e as Error).message}`, 'err');
    }
  }

  function pick(fm: string, key: string) {
    const m = fm.match(new RegExp(`^${key}:\\s*(.*)$`, 'm'));
    if (!m) return '';
    return m[1].trim().replace(/^["']|["']$/g, '');
  }

  function newFile() {
    currentSha = null;
    currentSlug = '';
    $('f-title').value = '';
    $('f-slug').value = '';
    $('f-date').value = new Date().toISOString().slice(0, 10);
    $('f-category').value = '技术';
    $('f-tags').value = '';
    $('f-excerpt').value = '';
    $('f-read').value = '5';
    $('f-body').value = '';
    $('file-state').textContent = '新文章';
    say('');
  }

  function compose() {
    const title = $('f-title').value.trim();
    const date = $('f-date').value || new Date().toISOString().slice(0, 10);
    const tags = $('f-tags')
      .value.split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const fm = [
      '---',
      `title: ${JSON.stringify(title)}`,
      `date: ${date}`,
      `category: ${JSON.stringify($('f-category').value.trim() || '随笔')}`,
      `tags: [${tags.map((t) => JSON.stringify(t)).join(', ')}]`,
      `excerpt: ${JSON.stringify($('f-excerpt').value.trim())}`,
      `readTime: ${Number($('f-read').value) || 5}`,
      '---',
      '',
    ].join('\n');
    return fm + $('f-body').value.trim() + '\n';
  }

  async function save() {
    const title = $('f-title').value.trim();
    if (!title) return say('标题不能为空', 'err');
    const slug = ($('f-slug').value.trim() || slugify(title)).replace(/\s+/g, '-');
    if (!slug) return say('文件名不能为空', 'err');
    const path = `${postsDir}/${slug}.md`;
    const body = {
      message: `post: ${title}`,
      content: b64encode(compose()),
      branch,
      ...(currentSha ? { sha: currentSha } : {}),
    };
    try {
      say('提交中…');
      await gh(`/repos/${owner}/${repo}/contents/${path}`, {
        method: 'PUT',
        body: JSON.stringify(body),
      });
      say(`已提交 ${slug}.md`, 'ok');
      currentSlug = slug;
      $('file-state').textContent = `编辑 ${slug}.md`;
      loadFiles();
      const res = await gh(`/repos/${owner}/${repo}/contents/${path}?ref=${branch}`);
      currentSha = res.sha;
    } catch (e) {
      say(`提交失败：${(e as Error).message}`, 'err');
    }
  }

  async function remove() {
    if (!currentSha || !currentSlug) return say('没有选中文件', 'err');
    if (!confirm(`删除 ${currentSlug}.md？该操作会直接提交到仓库。`)) return;
    try {
      await gh(`/repos/${owner}/${repo}/contents/${postsDir}/${currentSlug}.md`, {
        method: 'DELETE',
        body: JSON.stringify({
          message: `post: delete ${currentSlug}`,
          sha: currentSha,
          branch,
        }),
      });
      say('已删除', 'ok');
      currentSha = null;
      newFile();
      loadFiles();
    } catch (e) {
      say(`删除失败：${(e as Error).message}`, 'err');
    }
  }

  async function upload(file: File) {
    const name = `${Date.now()}-${file.name.replace(/[^\w.-]/g, '_')}`;
    const path = `${imagesDir}/${name}`;
    const buf = new Uint8Array(await file.arrayBuffer());
    let bin = '';
    buf.forEach((b) => (bin += String.fromCharCode(b)));
    try {
      say('上传中…');
      await gh(`/repos/${owner}/${repo}/contents/${path}`, {
        method: 'PUT',
        body: JSON.stringify({
          message: `image: ${name}`,
          content: btoa(bin),
          branch,
        }),
      });
      const ta = $<HTMLTextAreaElement>('f-body');
      const snippet = `![](/images/${name})`;
      const pos = ta.selectionStart;
      ta.value = ta.value.slice(0, pos) + snippet + ta.value.slice(pos);
      say(`已插入 /images/${name}`, 'ok');
    } catch (e) {
      say(`上传失败：${(e as Error).message}`, 'err');
    }
  }

  function slugify(s: string) {
    const ascii = s
      .toLowerCase()
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-')
      .replace(/^-|-$/g, '');
    return ascii || `post-${Date.now().toString(36)}`;
  }

  $('auth-btn').addEventListener('click', () => {
    token = $<HTMLInputElement>('token').value.trim();
    if (!token) return;
    localStorage.setItem(tokenKey, token);
    verify();
  });
  $('forget-btn').addEventListener('click', () => {
    localStorage.removeItem(tokenKey);
    token = '';
    $('auth-state').textContent = '已清除';
    $('editor').classList.add('hidden');
  });
  $('new-btn').addEventListener('click', newFile);
  $('save-btn').addEventListener('click', save);
  $('del-btn').addEventListener('click', remove);
  $('refresh-btn').addEventListener('click', loadFiles);
  $('upload-btn').addEventListener('click', () => $<HTMLInputElement>('upload').click());
  $('upload').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) upload(f);
  });

  if (token) {
    $<HTMLInputElement>('token').value = token;
    verify();
  }
</script>

<style>
  .admin { padding: clamp(5rem, 12vh, 8rem) 0 6rem; }
  .narrow { max-width: 52rem; }
  .head { margin-bottom: clamp(2.4rem, 5vw, 3.4rem); }
  .headline { margin: 1rem 0 0; font-size: clamp(2rem, 5vw, 2.8rem); }
  .hint { margin: 1.2rem 0 0; color: var(--muted); font-size: 0.88rem; line-height: 1.9; }

  .panel { padding: clamp(1.4rem, 3vw, 2rem) 0; border-top: 1px solid var(--line); }
  .panel.hidden { display: none; }

  .field { display: block; margin-bottom: 1rem; }
  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--faint);
    margin-bottom: 0.45rem;
  }

  input[type='text'],
  input[type='password'],
  input[type='date'],
  input[type='number'],
  textarea {
    width: 100%;
    padding: 0.6rem 0.7rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.24s var(--ease);
  }
  textarea { font-family: var(--font-mono); font-size: 0.84rem; line-height: 1.8; resize: vertical; }
  input:focus, textarea:focus { border-color: var(--orange); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0 1rem;
  }

  .row { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .row.between { justify-content: space-between; margin-bottom: 1.2rem; }

  .btn {
    padding: 0.42rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink);
    border: 1px solid var(--line);
    transition: border-color 0.24s var(--ease), color 0.24s var(--ease), background 0.24s var(--ease);
  }
  .btn:hover { border-color: var(--ink); }
  .btn.primary { border-color: var(--orange); color: var(--orange); }
  .btn.primary:hover { background: var(--orange); color: #fff; }
  .btn.danger:hover { border-color: #c0392b; color: #c0392b; }

  .state { font-family: var(--font-mono); font-size: 0.7rem; color: var(--faint); }
  .state[data-tone='ok'] { color: #2f8f5b; }
  .state[data-tone='err'] { color: #c0392b; }

  .files { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .file {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    transition: color 0.24s var(--ease), border-color 0.24s var(--ease);
  }
  .file:hover { color: var(--orange); border-color: var(--orange); }
</style>
