---
import { site } from '../site.config';
---

<div class="player" id="player">
  <audio id="bgm" src={site.music.src} loop preload="auto" muted playsinline></audio>
  <button id="bgm-btn" class="btn" aria-label="播放或静音" aria-pressed="false" title={site.music.title}>
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</div>

<style>
  .player {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
  }
  .btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .btn:hover { opacity: 1; }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .bars i {
    display: block;
    width: 2px;
    height: 3px;
    background: var(--ink);
    transition: height 0.3s var(--ease), background 0.3s var(--ease);
  }
  .playing .bars i { background: var(--orange); }
  .playing .bars i:nth-child(1) { animation: eq 1.1s ease-in-out infinite; }
  .playing .bars i:nth-child(2) { animation: eq 0.8s ease-in-out infinite 0.15s; }
  .playing .bars i:nth-child(3) { animation: eq 1.3s ease-in-out infinite 0.3s; }
  .muted .bars i { height: 3px !important; }

  @keyframes eq {
    0%, 100% { height: 3px; }
    50% { height: 12px; }
  }
</style>

<script is:inline>
  (function () {
    var audio = document.getElementById('bgm');
    var wrap = document.getElementById('player');
    var btn = document.getElementById('bgm-btn');
    if (!audio || !btn) return;

    var target = 0.4;
    var unlocked = false;
    var userMuted = false;

    function fadeIn() {
      var t0 = performance.now();
      audio.volume = 0;
      function step(t) {
        var k = Math.min(1, (t - t0) / 900);
        audio.volume = target * k;
        if (k < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function unlock() {
      if (unlocked || userMuted) return;
      unlocked = true;
      audio.muted = false;
      var p = audio.play();
      if (p && p.then) p.then(fadeIn).catch(function () {});
      else fadeIn();
      wrap.classList.add('playing');
      wrap.classList.remove('muted');
      btn.setAttribute('aria-pressed', 'true');
    }

    var evts = ['pointerdown', 'touchstart', 'keydown', 'wheel', 'scroll'];
    evts.forEach(function (e) {
      window.addEventListener(e, unlock, { once: true, passive: true });
    });

    audio.play().catch(function () {});

    btn.addEventListener('click', function (ev) {
      ev.stopPropagation();
      userMuted = !userMuted;
      audio.muted = userMuted;
      if (!userMuted) {
        unlocked = true;
        audio.play().then(function () {
          audio.volume = target;
        }).catch(function () {});
      }
      wrap.classList.toggle('playing', !userMuted);
      wrap.classList.toggle('muted', userMuted);
      btn.setAttribute('aria-pressed', String(!userMuted));
    });

    wrap.classList.add('muted');
  })();
</script>
