---
import { site } from '../site.config';
---

<div class="player" id="player" data-default={site.music.volume} transition:persist="player">
  <audio id="bgm" src={site.music.src} loop preload="auto" muted playsinline title={site.music.title}></audio>

  <label class="vol-wrap" title="音量">
    <input id="vol" class="vol" type="range" min="0" max="100" step="1" value="40" aria-label="音量" />
  </label>

  <button id="bgm-btn" class="btn" aria-label="播放或静音" aria-pressed="false" title={site.music.title}>
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</div>

<style>
  .player {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .vol-wrap {
    display: flex;
    align-items: center;
    height: 18px;
    opacity: 0.4;
    transition: opacity 0.3s var(--ease);
  }
  .vol-wrap:hover,
  .vol-wrap:focus-within { opacity: 0.9; }

  .vol {
    -webkit-appearance: none;
    appearance: none;
    width: 64px;
    height: 18px;
    margin: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }
  .vol::-webkit-slider-runnable-track {
    height: 1px;
    background: linear-gradient(
      to right,
      var(--ink) 0 var(--pct, 40%),
      var(--line) var(--pct, 40%) 100%
    );
  }
  .vol::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .vol::-moz-range-track {
    height: 1px;
    background: var(--line);
  }
  .vol::-moz-range-progress {
    height: 1px;
    background: var(--ink);
  }
  .vol::-moz-range-thumb {
    width: 7px;
    height: 7px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .vol:focus-visible { outline: 1px solid var(--orange); outline-offset: 4px; }

  .btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .btn:hover { opacity: 1; }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .bars i {
    display: block;
    width: 2px;
    height: 3px;
    background: var(--ink);
    transition: height 0.3s var(--ease), background 0.3s var(--ease);
  }
  .playing .bars i { background: var(--orange); }
  .playing .bars i:nth-child(1) { animation: eq 1.1s ease-in-out infinite; }
  .playing .bars i:nth-child(2) { animation: eq 0.8s ease-in-out infinite 0.15s; }
  .playing .bars i:nth-child(3) { animation: eq 1.3s ease-in-out infinite 0.3s; }
  .muted .bars i { height: 3px !important; animation: none !important; background: var(--ink); }

  @keyframes eq {
    0%, 100% { height: 3px; }
    50% { height: 12px; }
  }

  @media (max-width: 560px) {
    .vol { width: 48px; }
    .player { gap: 0.4rem; }
  }
</style>

<script is:inline>
  (function () {
    // View Transitions 会复用同一个节点；重复执行时直接退出
    if (window.__bgmReady) return;
    var audio = document.getElementById('bgm');
    var wrap = document.getElementById('player');
    var btn = document.getElementById('bgm-btn');
    var rail = document.getElementById('vol');
    if (!audio || !wrap || !btn || !rail) return;
    window.__bgmReady = true;

    var KEY_V = 'bgm.volume';
    var KEY_M = 'bgm.muted';
    var fallback = parseFloat(wrap.getAttribute('data-default')) || 0.4;

    function readVolume() {
      var v = parseFloat(localStorage.getItem(KEY_V));
      if (!isFinite(v) || v < 0 || v > 1) v = fallback;
      return v;
    }

    var volume = readVolume();
    var muted = localStorage.getItem(KEY_M) === '1' || volume === 0;
    var unlocked = false;

    function paint() {
      var pct = Math.round(volume * 100);
      rail.value = String(pct);
      rail.style.setProperty('--pct', pct + '%');
      var audible = !muted && unlocked && !audio.paused;
      wrap.classList.toggle('playing', audible);
      wrap.classList.toggle('muted', !audible);
      btn.setAttribute('aria-pressed', String(audible));
    }

    function fadeTo(target) {
      var start = audio.volume;
      var t0 = performance.now();
      function step(t) {
        var k = Math.min(1, (t - t0) / 700);
        audio.volume = start + (target - start) * k;
        if (k < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function startSilent() {
      audio.muted = true;
      audio.volume = 0;
      var p = audio.play();
      if (p && p.then) p.catch(function () {});
    }

    // 先试带声自动播放：浏览器若判定本站有播放历史（MEI），会直接放行。
    // 被拒时退回静音播放，等第一次真实手势再淡入。失败不做永久锁定，下次手势可重试。
    var lastTry = 0;
    function trySound() {
      if (muted || unlocked) return;
      var now = performance.now();
      if (now - lastTry < 350) return;
      lastTry = now;
      audio.muted = false;
      audio.volume = 0;
      var p = audio.play();
      if (!p || !p.then) {
        unlocked = true;
        fadeTo(volume);
        paint();
        return;
      }
      p.then(function () {
        unlocked = true;
        fadeTo(volume);
        paint();
      }).catch(function () {
        if (audio.paused) startSilent();
        paint();
      });
    }

    ['pointerdown', 'touchstart', 'keydown', 'click', 'wheel', 'scroll'].forEach(function (e) {
      window.addEventListener(e, trySound, { passive: true });
    });

    if (muted) {
      audio.muted = true;
      audio.volume = 0;
    } else {
      trySound();
    }

    btn.addEventListener('click', function (ev) {
      ev.stopPropagation();
      muted = !muted;
      if (!muted) {
        unlocked = true;
        if (volume === 0) volume = fallback;
        audio.muted = false;
        audio.volume = volume;
        audio.play().catch(function () {});
      } else {
        audio.muted = true;
      }
      try { localStorage.setItem(KEY_M, muted ? '1' : '0'); } catch (e) {}
      paint();
    });

    rail.addEventListener('input', function () {
      volume = Math.min(1, Math.max(0, parseInt(rail.value, 10) / 100));
      muted = volume === 0;
      unlocked = true;
      try {
        localStorage.setItem(KEY_V, String(volume));
        localStorage.setItem(KEY_M, muted ? '1' : '0');
      } catch (e) {}
      audio.muted = muted;
      audio.volume = muted ? 0 : volume;
      audio.play().catch(function () {});
      paint();
    });

    paint();
  })();
</script>
