---
import { site } from '../site.config';
---

<section class="field">
  <div class="center">
    <h1 class="display hero-title" aria-label={site.title} data-type={site.title}>
      <span class="ghost" aria-hidden="true">{site.title}</span>
      <span class="typed" aria-hidden="true">
        <span class="typed-txt"></span><span class="caret"></span>
      </span>
    </h1>
    <span class="dash" aria-hidden="true"></span>
    <p class="hero-tag" data-type={site.tagline}>
      <span class="sr-only">{site.tagline}</span>
      <span class="ghost" aria-hidden="true">{site.tagline}</span>
      <span class="typed" aria-hidden="true">
        <span class="typed-txt"></span><span class="caret"></span>
      </span>
    </p>
  </div>

  <a class="scroll" href="#posts" aria-label="滚动进入文章列表">
    <svg width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true">
      <path d="M7 1v14M2 10.5 7 15.5l5-5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .field {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: var(--field);
    color: var(--hero-ink);
    overflow: hidden;
  }

  .center {
    text-align: center;
    padding: 0 var(--gutter);
    animation: settle 1.4s var(--ease) both;
  }

  .hero-title {
    position: relative;
    display: inline-block;
    margin: 0;
    font-size: clamp(3rem, 10.5vw, 8.2rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
    animation: settle 1.5s var(--ease) 0.16s both;
  }

  /* 隐形占位：保证打字过程中宽度固定，标题与签名都不会左右抖动 */
  .ghost { visibility: hidden; }

  .typed {
    position: absolute;
    inset: 0;
  }
  .hero-title .typed {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-tag .typed {
    display: block;
    text-align: center;
  }

  .typed-txt {
    display: inline-block;
  }
  /* 签名会换行：必须留成行内文本，否则行内块会占满整行，把光标挤到下一行去 */
  .hero-tag .typed-txt {
    display: inline;
  }

  .caret {
    flex: 0 0 auto;
    display: inline-block;
    width: max(1.5px, 0.022em);
    height: 0.78em;
    margin-left: 0.02em;
    background: currentColor;
    opacity: 0;
  }
  .is-typing .caret {
    opacity: 0.55;
    animation: blink 1.06s steps(1, end) infinite;
  }
  .is-typing.typing .caret {
    animation: none;
    opacity: 0.78;
  }

  .dash {
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: clamp(1.2rem, 3vw, 2.2rem) auto 0;
    background: var(--hero-rule);
    transform-origin: center;
    animation: widen 1.4s var(--ease) 0.5s both;
  }

  .hero-tag {
    position: relative;
    margin: clamp(1rem, 2.4vw, 1.6rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    letter-spacing: 0.16em;
    text-wrap: balance;
    color: var(--hero-mid);
    animation: settle 1.3s var(--ease) 0.34s both;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.6rem, 4vh, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    color: var(--hero-dim);
    transform: translateX(-50%);
    transition: color 0.3s var(--ease);
    will-change: transform;
  }
  .scroll:hover { color: var(--hero-ink); }
  .scroll svg { animation: nudge 2.4s ease-in-out infinite; }

  @keyframes settle {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes widen {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(5px); opacity: 1; }
  }
  @keyframes blink {
    0%, 49% { opacity: 0.55; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .center, .hero-title, .dash, .hero-tag { animation: none; }
    .caret { display: none; }
  }
</style>

<script>
  // 节奏：名字打完 → 签名打 → 停留 → 签名先退 → 名字后退 → 间隔 → 循环
  const NAME_TYPE = 108;
  const NAME_DEL = 52;
  const TAG_TYPE = 52;
  const TAG_DEL = 26;
  const HOLD = 2600;
  const LINK = 340;
  const GAP = 520;
  const START = 620;

  let timer = 0;

  function line(el: HTMLElement) {
    return {
      el,
      out: el.querySelector<HTMLElement>('.typed-txt'),
      text: el.dataset.type || '',
    };
  }

  type Line = ReturnType<typeof line>;
  let lines: Line[] = [];

  // 光标只在当前正在打字的那一行上，另一行必须收起，否则两个光标同时闪
  function focus(l: Line) {
    lines.forEach((x) => x.el.classList.remove('is-typing', 'typing'));
    l.el.classList.add('is-typing');
  }

  function type(l: Line, speed: number, done: () => void) {
    if (!l.out) return done();
    const out = l.out;
    let i = 0;
    focus(l);
    l.el.classList.add('typing');
    const tick = () => {
      i += 1;
      out.textContent = l.text.slice(0, i);
      if (i >= l.text.length) {
        l.el.classList.remove('typing');
        done();
        return;
      }
      timer = window.setTimeout(tick, speed + Math.random() * 24);
    };
    timer = window.setTimeout(tick, speed);
  }

  function erase(l: Line, speed: number, done: () => void) {
    if (!l.out) return done();
    const out = l.out;
    let i = out.textContent ? out.textContent.length : 0;
    focus(l);
    l.el.classList.add('typing');
    const tick = () => {
      i -= 1;
      out.textContent = l.text.slice(0, Math.max(0, i));
      if (i <= 0) {
        l.el.classList.remove('typing', 'is-typing');
        done();
        return;
      }
      timer = window.setTimeout(tick, speed);
    };
    timer = window.setTimeout(tick, speed);
  }

  function initType() {
    const nameEl = document.querySelector<HTMLElement>('.hero-title');
    const tagEl = document.querySelector<HTMLElement>('.hero-tag');
    if (!nameEl || !tagEl) return;
    if (nameEl.dataset.run === '1') return;
    nameEl.dataset.run = '1';

    const name = line(nameEl);
    const tag = line(tagEl);
    lines = [name, tag];

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (name.out) name.out.textContent = name.text;
      if (tag.out) tag.out.textContent = tag.text;
      return;
    }

    const cycle = () => {
      type(name, NAME_TYPE, () => {
        timer = window.setTimeout(() => {
          type(tag, TAG_TYPE, () => {
            timer = window.setTimeout(() => {
              erase(tag, TAG_DEL, () => {
                timer = window.setTimeout(() => {
                  erase(name, NAME_DEL, () => {
                    timer = window.setTimeout(cycle, GAP);
                  });
                }, LINK);
              });
            }, HOLD);
          });
        }, LINK);
      });
    };

    timer = window.setTimeout(cycle, START);
  }

  function initMagnet() {
    const hint = document.querySelector<HTMLElement>('.scroll');
    const field = document.querySelector<HTMLElement>('.field');
    if (!hint || !field || field.dataset.magnet === '1') return;
    field.dataset.magnet = '1';
    field.addEventListener('pointermove', (e) => {
      const r = hint.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / 40;
      const dy = (e.clientY - (r.top + r.height / 2)) / 40;
      const x = Math.max(-6, Math.min(6, dx));
      const y = Math.max(-6, Math.min(6, dy));
      hint.style.transform = `translate(calc(-50% + ${x}px), ${y}px)`;
    });
    field.addEventListener('pointerleave', () => {
      hint.style.transform = 'translateX(-50%)';
    });
  }

  function boot() {
    initType();
    initMagnet();
  }

  document.addEventListener('astro:before-swap', () => window.clearTimeout(timer));
  document.addEventListener('astro:page-load', boot);
  boot();
</script>
