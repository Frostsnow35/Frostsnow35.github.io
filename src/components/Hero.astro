---
import { site } from '../site.config';
---

<section class="field">
  <div class="center">
    <h1 class="display hero-title" aria-label={site.title} data-type={site.title}>
      <span class="ghost" aria-hidden="true">{site.title}</span>
      <span class="typed" aria-hidden="true">
        <span class="typed-txt"></span><span class="caret"></span>
      </span>
    </h1>
    <span class="dash" aria-hidden="true"></span>
    <p class="hero-tag">{site.tagline}</p>
  </div>

  <a class="scroll" href="#posts" aria-label="滚动进入文章列表">
    <svg width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true">
      <path d="M7 1v14M2 10.5 7 15.5l5-5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<style>
  .field {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: var(--field);
    color: var(--hero-ink);
    overflow: hidden;
  }

  .center {
    text-align: center;
    padding: 0 var(--gutter);
    animation: settle 1.4s var(--ease) both;
  }

  .hero-title {
    position: relative;
    display: inline-block;
    margin: 0;
    font-size: clamp(3rem, 10.5vw, 8.2rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
    animation: settle 1.5s var(--ease) 0.16s both;
  }

  /* 隐形占位：保证打字过程中标题区宽度固定，不会左右抖动 */
  .ghost { visibility: hidden; }

  .typed {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .typed-txt {
    flex: 0 0 auto;
    display: inline-block;
    text-align: left;
  }

  .caret {
    flex: 0 0 auto;
    display: inline-block;
    width: max(1.5px, 0.022em);
    height: 0.78em;
    margin-left: 0.02em;
    background: currentColor;
    opacity: 0.55;
    animation: blink 1.06s steps(1, end) infinite;
  }
  .typing .caret {
    animation: none;
    opacity: 0.75;
  }

  .dash {
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: clamp(1.2rem, 3vw, 2.2rem) auto 0;
    background: var(--hero-rule);
    transform-origin: center;
    animation: widen 1.4s var(--ease) 0.5s both;
  }

  .hero-tag {
    margin: clamp(1rem, 2.4vw, 1.6rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    letter-spacing: 0.16em;
    text-wrap: balance;
    color: var(--hero-mid);
    animation: settle 1.3s var(--ease) 0.34s both;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.6rem, 4vh, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    color: var(--hero-dim);
    transform: translateX(-50%);
    transition: color 0.3s var(--ease);
    will-change: transform;
  }
  .scroll:hover { color: var(--hero-ink); }
  .scroll svg { animation: nudge 2.4s ease-in-out infinite; }

  @keyframes settle {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes widen {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(5px); opacity: 1; }
  }
  @keyframes blink {
    0%, 49% { opacity: 0.55; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .center, .hero-title, .dash, .hero-tag { animation: none; }
    .caret { animation: none; opacity: 0.4; }
  }
</style>

<script>
  let typeTimer = 0;

  function typeTitle() {
    const host = document.querySelector<HTMLElement>('[data-type]');
    if (!host) return;
    const out = host.querySelector<HTMLElement>('.typed-txt');
    const text = host.dataset.type || '';
    if (!out) return;
    if (host.dataset.run === '1') return;
    host.dataset.run = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      out.textContent = text;
      return;
    }

    const TYPE = 108;
    const DEL = 52;
    const HOLD = 1700;
    const GAP = 460;

    let i = 0;
    let dir = 1;

    const step = () => {
      if (dir === 1) {
        i += 1;
        out.textContent = text.slice(0, i);
        if (i >= text.length) {
          dir = -1;
          host.classList.remove('typing');
          typeTimer = window.setTimeout(step, HOLD);
          return;
        }
        host.classList.add('typing');
        typeTimer = window.setTimeout(step, TYPE + Math.random() * 40);
        return;
      }
      i -= 1;
      out.textContent = text.slice(0, Math.max(0, i));
      if (i <= 0) {
        dir = 1;
        host.classList.remove('typing');
        typeTimer = window.setTimeout(step, GAP);
        return;
      }
      host.classList.add('typing');
      typeTimer = window.setTimeout(step, DEL);
    };

    typeTimer = window.setTimeout(step, 620);
  }

  function initMagnet() {
    const hint = document.querySelector<HTMLElement>('.scroll');
    const field = document.querySelector<HTMLElement>('.field');
    if (!hint || !field || field.dataset.magnet === '1') return;
    field.dataset.magnet = '1';
    field.addEventListener('pointermove', (e) => {
      const r = hint.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / 40;
      const dy = (e.clientY - (r.top + r.height / 2)) / 40;
      const x = Math.max(-6, Math.min(6, dx));
      const y = Math.max(-6, Math.min(6, dy));
      hint.style.transform = `translate(calc(-50% + ${x}px), ${y}px)`;
    });
    field.addEventListener('pointerleave', () => {
      hint.style.transform = 'translateX(-50%)';
    });
  }

  function boot() {
    typeTitle();
    initMagnet();
  }

  document.addEventListener('astro:before-swap', () => window.clearTimeout(typeTimer));
  document.addEventListener('astro:page-load', boot);
  boot();
</script>
