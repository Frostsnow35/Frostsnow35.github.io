---
import { site } from '../site.config';
---

<section class="field">
  <div class="center">
    <p class="eyebrow hero-eyebrow">{site.eyebrow}</p>
    <h1 class="display hero-title">{site.title}</h1>
    <span class="dash" aria-hidden="true"></span>
    <p class="hero-tag">{site.tagline}</p>
  </div>

  <a class="scroll" href="#posts" aria-label="滚动进入文章列表">
    <svg width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true">
      <path d="M7 1v14M2 10.5 7 15.5l5-5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>滚动进入</span>
  </a>
</section>

<style>
  .field {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: var(--field);
    color: var(--hero-ink);
    overflow: hidden;
  }

  .center {
    text-align: center;
    padding: 0 var(--gutter);
    animation: settle 1.4s var(--ease) both;
  }

  .hero-eyebrow {
    color: var(--hero-dim);
    margin: 0 0 clamp(1rem, 3vw, 2.2rem);
    animation: settle 1.2s var(--ease) 0.1s both;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(3rem, 10.5vw, 8.2rem);
    letter-spacing: 0.04em;
    text-indent: 0.04em;
    animation: settle 1.5s var(--ease) 0.16s both;
  }

  .dash {
    display: block;
    width: 3.5rem;
    height: 1px;
    margin: clamp(1.2rem, 3vw, 2.2rem) auto 0;
    background: var(--hero-rule);
    transform-origin: center;
    animation: widen 1.4s var(--ease) 0.5s both;
  }

  .hero-tag {
    margin: clamp(1rem, 2.4vw, 1.6rem) 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    letter-spacing: 0.22em;
    color: var(--hero-mid);
    animation: settle 1.3s var(--ease) 0.34s both;
  }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.6rem, 4vh, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    color: var(--hero-dim);
    font-size: 0.66rem;
    letter-spacing: 0.34em;
    transform: translateX(-50%);
    transition: color 0.3s var(--ease);
    will-change: transform;
  }
  .scroll:hover { color: var(--hero-ink); }
  .scroll svg { animation: nudge 2.4s ease-in-out infinite; }

  @keyframes settle {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes widen {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(5px); opacity: 1; }
  }
</style>

<script>
  const hint = document.querySelector<HTMLElement>('.scroll');
  const field = document.querySelector<HTMLElement>('.field');
  if (hint && field) {
    field.addEventListener('pointermove', (e) => {
      const r = hint.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / 40;
      const dy = (e.clientY - (r.top + r.height / 2)) / 40;
      const x = Math.max(-6, Math.min(6, dx));
      const y = Math.max(-6, Math.min(6, dy));
      hint.style.transform = `translate(calc(-50% + ${x}px), ${y}px)`;
    });
    field.addEventListener('pointerleave', () => {
      hint.style.transform = 'translateX(-50%)';
    });
  }
</script>
